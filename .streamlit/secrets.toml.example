# ──────────────────────────────────────────────────────────────────────────────
# NBA Whale Pro · template credenziali
#
# COSA FARE:
# 1. Copia questo file in .streamlit/secrets.toml (NON committarlo: è in .gitignore)
# 2. Inserisci le TUE chiavi API tra le virgolette
# 3. Su Streamlit Cloud invece: Dashboard → la tua app → ⋮ → Settings → Secrets,
#    incolla lo stesso contenuto in formato TOML.
#
# Le chiavi non finiscono mai nel codice sorgente né nel repo Git.
# ──────────────────────────────────────────────────────────────────────────────

# Obbligatoria · NBA stats da api-sports.io (https://dashboard.api-football.com/)
API_SPORTS_KEY = "INCOLLA_QUI_LA_TUA_API_SPORTS_KEY"

# Opzionale · linee/quote reali da The Odds API (https://the-odds-api.com)
ODDS_API_KEY = "INCOLLA_QUI_LA_TUA_ODDS_API_KEY"

# Opzionali · notifiche Telegram (token da BotFather, chat_id dal bot)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID   = ""
